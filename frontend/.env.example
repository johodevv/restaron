# ─────────────────────────────────────────────────────────────
# Frontend muhit sozlamalari
# ─────────────────────────────────────────────────────────────
# MUHIM: bu qiymatlar BUILD paytida bundle ichiga yoziladi.
# O'zgartirgandan keyin qaytadan build qilish shart (npm run build).

# 1) Mahalliy ishlab chiqish (backend shu kompyuterda):
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1/ws

# 2) Restoran Wi-Fi tarmog'i (backend serveri LAN da):
#    Bu holda saytni ham backend manzilidan oching — backend frontend'ni
#    o'zi tarqatadi (http://192.168.1.50:8000). Shunda bu o'zgaruvchilar
#    umuman kerak emas.
# VITE_API_URL=http://192.168.1.50:8000/api/v1
# VITE_WS_URL=ws://192.168.1.50:8000/api/v1/ws

# 3) Vercel / internet (https) deploy:
#    DIQQAT: sayt https bo'lsa, API ham MAJBURIY https bo'lishi kerak.
#    http:// manzil brauzer tomonidan bloklanadi (mixed content) va
#    "Server bilan aloqa yo'q" xatosini beradi.
# VITE_API_URL=https://restaron-backend.onrender.com/api/v1
# VITE_WS_URL=wss://restaron-backend.onrender.com/api/v1/ws
