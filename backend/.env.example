# Database — PostgreSQL (Production, High-Concurrency & Rush-Hour uchun tavsiya etiladi)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/restaron_db
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/restaron_db

# Yoki SQLite (Faqat sinov va lokal development uchun)
# DATABASE_URL=sqlite+aiosqlite:///./restaron.db
# SYNC_DATABASE_URL=sqlite:///./restaron.db

# Database Connection Pool sozlamalari (PostgreSQL uchun)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# JWT
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App
APP_NAME=RestAron
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=False
AUTO_SEED=false

# CORS
FRONTEND_URL=http://localhost:5173

# QR Code base URL (sayt URL'i)
QR_BASE_URL=http://localhost:5173

# Upload directory
UPLOAD_DIR=uploads

# Developer commission (%)
COMMISSION_PERCENT=5.0
