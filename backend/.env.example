# App
APP_NAME=RestAron
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True

# CORS
FRONTEND_URL=http://localhost:5173

# QR Code base URL (sayt URL'i)
QR_BASE_URL=http://localhost:5173

# Upload directory
UPLOAD_DIR=uploads

# Developer commission (%)
COMMISSION_PERCENT=5.0
